{
  "name": "backend",
  "version": "1.0.0",
  "description": "ATS backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node scripts/generate-version.js && node src/scripts/addIndexes.js && node src/index.js",
    "dev": "node scripts/generate-version.js && node src/scripts/addIndexes.js && node src/index.js",
    "build": "npm install && npx prisma generate && node scripts/generate-version.js",
    "test": "jest --testTimeout=30000 --runInBand",
    "test:ci": "jest --testTimeout=30000 --runInBand --forceExit --ci --json --outputFile=jest-results.json",
    "test:unit": "jest --config jest.unit.config.js",
    "lint": "eslint src/ --ext .js --max-warnings 0",
    "ci:smoke": "node scripts/smoke.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@vercel/edge-config": "^1.4.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.80.10",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "prisma": "^6.7.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
