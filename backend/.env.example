# ─────────────────────────────────────────────────────────────────────────────
# ATS Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ats_platform?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="1d"

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# NOTE ON FILE STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# All file uploads (candidate resumes, profile photos, posted files, offer
# letters, scheduling files, recruitment reports) are stored as BYTEA binary
# data directly in the PostgreSQL database via the FileMeta / PostedFile /
# SchedulingMemberFile / RecruitmentReport models.
#
# NO Cloudinary account or credentials are needed. Cloudinary was fully
# removed in commit a36ad5a (Aug 2026). Do NOT re-add Cloudinary.
#
# Files survive Render redeploys because they live in Neon PostgreSQL, not on
# Render's ephemeral local filesystem.
#
# Bulk upload input files (CSV/XLSX for candidate/feedback/interview imports)
# are temporarily written to the local /uploads/temp directory and deleted
# by the background processor. These are transient and are never served to users.
